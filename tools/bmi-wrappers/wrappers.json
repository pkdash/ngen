{
  "_comment": [
    "Registry of Python BMI wrapper packages usable for introspection.",
    "Paths are relative to the ngen repo root. JSON rather than TOML because the",
    "devcontainer ships Python 3.10, which has no stdlib tomllib.",
    "Every distribution is pinned in requirements.txt; sample configs are optional.",
    "bmi_setup_key links a model to its bmi_setup (pkdash/BMI) model and parameter catalog; ngen_bmi needs it.",
    "Only models with a bmi_setup catalog (cfe, noah, pet, topmodel) have the key. Without it ngen_bmi cannot set",
    "that model's parameters, but bmi_introspect.py still works. Add it after adding a catalog to bmi_setup/catalogs/.",
    "realization_model_types are matched exactly, ignoring case (ngen_bmi.registry.matches_model_type)."
  ],

  "cfe": {
    "description": "Conceptual Functional Equivalent (NOAA-OWP/cfe), via pymt_cfe",
    "distribution": "pymt_cfe",
    "import_path": "pymt_cfe",
    "class_name": "CFE",
    "bmi_setup_key": "cfe",
    "lib_file": "extern/cfe/cmake_build/libcfebmi.so",
    "build_env": {
      "CFE_ROOT": "extern/cfe/cfe",
      "CFE_LIB_DIR": "extern/cfe/cmake_build"
    },
    "sample_config": "data/gauge_01073000/CFE/cat-11223_bmi_config_cfe_pass.txt",
    "realization_model_types": ["bmi_c_cfe", "cfe"]
  },

  "noah": {
    "description": "Noah-OWP-Modular (NOAA-OWP/noah-owp-modular), via pymt_noah_owp",
    "distribution": "pymt_noah_owp",
    "import_path": "pymt_noah_owp",
    "class_name": "NOAH_OWP",
    "bmi_setup_key": "noah",
    "lib_file": "extern/noah-owp-modular/cmake_build/libsurfacebmi.so",
    "build_env": {
      "NOAH_ROOT": "extern/noah-owp-modular/noah-owp-modular",
      "NOAH_LIB_DIR": "extern/noah-owp-modular/cmake_build",
      "NOAH_MOD_DIR": "extern/noah-owp-modular/cmake_build/mod"
    },
    "sample_config": "data/gauge_01073000/NOAH/cat-11223.input",
    "realization_model_types": ["bmi_fortran_noahowp"]
  },

  "lasam": {
    "description": "LGAR soil-water model, via pymt_lasam",
    "distribution": "pymt_lasam",
    "import_path": "pymt_lasam",
    "class_name": "LASAM",
    "lib_file": "extern/lgar-c/cmake_build/liblasambmi.so",
    "build_env": {
      "LASAM_ROOT": "extern/lgar-c/LGAR-C",
      "LASAM_LIB_DIR": "extern/lgar-c/cmake_build",
      "LASAM_BMI_DIR": "extern/lgar-c/LGAR-C/bmi"
    },
    "sample_config": "extern/lgar-c/LGAR-C/configs/config_lasam_Phillipsburg.txt",
    "working_directory": "extern/lgar-c/LGAR-C",
    "realization_model_types": []
  },

